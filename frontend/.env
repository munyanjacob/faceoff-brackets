# The backend's base URL, including its /api path prefix - backend/'s
# routes live under src/app/api/ (see backend/src/app/api/discover/route.ts's
# own "GET /api/discover" comment), not at the bare paths
# docs/openapi.yaml's placeholder `servers` entry shows. Set (as here) to
# use the real backend via frontend/src/services/transport/httpTransport.ts;
# unset to fall back to the in-browser mockTransport.ts instead (issue #61).
# `backend/README.md` documents `npm run dev` as running at
# http://localhost:3000, hence the /api suffix here.
VITE_API_BASE_URL="http://localhost:3000/api"
