# Supabase — Settings → API (see backend/README.md for how to create a
# project; this frontend and backend/ share the one Supabase project).
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The backend's base URL, including its /api path prefix - backend/'s
# routes live under src/app/api/ (e.g. the discover endpoint is reachable
# at /api/discover, not the bare /discover docs/openapi.yaml's placeholder
# `servers` entry shows). See frontend/src/services/transport/index.ts:
# when this is set, the app talks to the real backend via httpTransport.ts;
# when it's unset, it falls back to the in-browser mockTransport.ts
# (issue #61 - useful for frontend-only development without a backend
# running at all).
#
# Local dev: backend/README.md documents `cd backend && npm run dev` as
# running at http://localhost:3000, so:
VITE_API_BASE_URL=http://localhost:3000/api
