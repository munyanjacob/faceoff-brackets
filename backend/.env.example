# Supabase — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — Settings → Database
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Round-advancement cron endpoint auth (any random string)
CRON_SECRET=generate-a-random-string

# Signs the anonymous-voter cookie (issue #35, any random string) so it
# can't be hand-edited to reset a voter's identity. Optional locally - an
# unset value falls back to an insecure dev-only default with a console
# warning (see src/app/brackets/[id]/voter-identity.ts) - but should be set
# in any real/deployed environment.
VOTE_COOKIE_SECRET=generate-a-random-string
