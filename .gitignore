# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns below are unanchored (no leading slash) so they match inside
# backend/ (and any other app directory) as well as at the repo root, now
# that the Next.js app lives in backend/ rather than at the repo root
# (issue #45). frontend/ has its own .gitignore for its own build output.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

backend/src/generated/prisma

# parallel-agent git worktrees
/.worktrees/
